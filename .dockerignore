# Backend production and development builds both COPY this context.
# Verify with: python scripts/verify_build_context.py

# The API serves this prebuilt public bundle. Keep this exception before all
# local-input exclusions so private files inside the bundle remain excluded.
**/dist
!dashboard/dist
!dashboard/dist/**
dashboard/dist/**/dist

# Local environments; retain only explicitly named public templates.
**/.env
**/.env.*
**/*.env
!**/.env.example
!**/.env.*.example

# Credential files and tool authentication state (not source modules such as
# src/secrets.py or src/credentials.py).
**/secrets
**/.secrets
**/credentials
**/.credentials
**/credentials.json
**/service-account*.json
**/*.key
**/*.pem
**/*.crt
**/*.cert
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/.aws
**/.ssh
**/.docker
**/.kube
**/.netrc
**/.npmrc
**/.pypirc

# Local assistant state and release policy inputs are not runtime assets.
**/.claude
**/.codex
**/.agents
**/.cursor
**/.gemini
**/.aider*
**/AGENTS.md
**/CLAUDE.md
**/.release-*

# Dependency environments and generated files, at every directory depth.
**/.venv
**/venv
**/env
**/ENV
**/.Python
**/__pycache__
**/*.py[cod]
**/*$py.class
**/*.so
**/*.egg-info
**/node_modules
**/build
**/dist-ssr
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.cache
**/.coverage*
**/coverage.xml
**/coverage
**/coverage_html
**/htmlcov
**/test-results
**/playwright-report
**/*.log
**/*.sqlite
**/*.sqlite3
**/*.db
**/uploads
**/logs
**/tmp
**/temp
data/piper-voices

# Editor, version-control and operating-system state.
**/.vscode
**/.idea
**/*.swp
**/*.swo
**/*~
**/.git
**/.gitignore
**/.DS_Store
**/Thumbs.db

# Development-only repository inputs.
Dockerfile.dev
docker-compose*.yml
*.md
docs
test_*.py
tests
