# Production Environment Variables
# Copy this file to .env.production and configure for your deployment
# NEVER commit actual credentials to git

# ===========================================
# REQUIRED - Docker Compose Production
# ===========================================

# PostgreSQL Database
POSTGRES_DB=aelira_prod
POSTGRES_USER=aelira
POSTGRES_PASSWORD=<generate-strong-password-32-chars>

# Redis Cache
REDIS_PASSWORD=<generate-strong-password-32-chars>

# ===========================================
# REQUIRED - API Configuration
# ===========================================

# Environment (production | staging | development)
ENV=production

# Gemini API Key (get from https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=<your-gemini-api-key>

# CORS Origins (JSON array - your frontend domains)
CORS_ORIGINS=["https://aelira.ai","https://dashboard.aelira.ai"]

# ===========================================
# OPTIONAL - Override Defaults
# ===========================================

# API Server
# API_HOST=0.0.0.0
# API_PORT=8000

# Ollama (local AI - internal Docker network)
# OLLAMA_HOST=http://ollama:11434

# Gemini Models (optional - sensible defaults provided)
# GEMINI_VISION_MODEL=gemini-2.5-flash-image
# GEMINI_TEXT_MODEL=gemini-2.0-flash

# Logging
# LOG_LEVEL=info

# ===========================================
# SECURITY NOTES
# ===========================================
# 1. Generate strong passwords: openssl rand -base64 32
# 2. Never commit this file with real values
# 3. Use secrets management in production (AWS Secrets Manager, Vault, etc.)
# 4. Rotate credentials regularly
# 5. Keep POSTGRES_PASSWORD same in both places (postgres service and DATABASE_URL)
