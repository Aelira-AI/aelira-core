# Development Environment Variables Example
# Copy this file to .env and update with your actual values
# NEVER commit .env to git - it's in .gitignore

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/aelira_dev

# Environment
ENV=development

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# CORS Origins (JSON array format for Pydantic)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# ===========================================
# LLM Provider Configuration
# ===========================================
# Choose your primary and fallback LLM providers
# Options: gemini, ollama, openai, anthropic

# Primary provider (default: gemini)
LLM_PROVIDER=gemini

# Fallback provider when primary fails (default: ollama)
LLM_FALLBACK_PROVIDER=ollama

# ===========================================
# Gemini API (Google) - Default Provider
# ===========================================
# Get your key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Override default Gemini models
# GEMINI_TEXT_MODEL=gemini-2.0-flash
# GEMINI_CODE_MODEL=gemini-2.0-flash
# GEMINI_VISION_MODEL=gemini-2.5-flash-image

# ===========================================
# Ollama (Local) - Privacy-First Option
# ===========================================
# No API key needed - runs locally on your machine
# Install Ollama: https://ollama.ai
OLLAMA_HOST=http://localhost:11434

# Optional: Override default Ollama models
# OLLAMA_TEXT_MODEL=llama3.2:3b
# OLLAMA_CODE_MODEL=qwen2.5-coder:3b
# OLLAMA_VISION_MODEL=llava:7b
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ===========================================
# OpenAI API (Optional - User's Own Key)
# ===========================================
# Set LLM_PROVIDER=openai to use OpenAI as primary
# Get your key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional: Override default OpenAI models
# OPENAI_TEXT_MODEL=gpt-4o-mini
# OPENAI_CODE_MODEL=gpt-4o
# OPENAI_VISION_MODEL=gpt-4o

# ===========================================
# Anthropic API (Optional - User's Own Key)
# ===========================================
# Set LLM_PROVIDER=anthropic to use Claude as primary
# Get your key at: https://console.anthropic.com/account/keys
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Optional: Override default Anthropic models
# ANTHROPIC_TEXT_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_CODE_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_VISION_MODEL=claude-3-5-sonnet-20241022

# ===========================================
# OAuth Token Encryption (Cloud Integrations)
# ===========================================
# SECURITY: Generate a new key with this command:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NEVER reuse keys between environments (dev/staging/prod)
TOKEN_ENCRYPTION_KEY=your-token-encryption-key-here

# ===========================================
# Google OAuth (Google Workspace Integration)
# ===========================================
# Get credentials at: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# ===========================================
# Microsoft OAuth (Microsoft 365 Integration)
# ===========================================
# Get credentials at: https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps
# MICROSOFT_CLIENT_ID=your-microsoft-client-id
# MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# ===========================================
# Moodle OAuth (Moodle LMS Integration)
# ===========================================
# World's most-used LMS: 60-70% Australia, 20% US market share
# Configure OAuth 2.0 in Moodle: Site administration > Server > OAuth 2 services
# MOODLE_CLIENT_ID=your-moodle-client-id
# MOODLE_CLIENT_SECRET=your-moodle-client-secret

# ===========================================
# D2L Brightspace OAuth (Brightspace LMS Integration)
# ===========================================
# Growing LMS: 15% US, 10% Australia market share (community colleges)
# Register OAuth 2.0 app in Brightspace: Admin Tools > Manage Extensibility
# Valence Learning Framework API: https://docs.valence.desire2learn.com/
# BRIGHTSPACE_CLIENT_ID=your-brightspace-client-id
# BRIGHTSPACE_CLIENT_SECRET=your-brightspace-client-secret

# ===========================================
# Canvas LMS OAuth (Canvas Integration)
# ===========================================
# Register OAuth app in Canvas: Admin > Developer Keys > +Developer Key
# CANVAS_OAUTH_CLIENT_ID=your-canvas-client-id
# CANVAS_OAUTH_CLIENT_SECRET=your-canvas-client-secret

# ===========================================
# SMTP Email (Transactional — via Mailcow)
# ===========================================
# Transactional emails (magic links, alerts, notifications) use SMTP.
# On VPS: Mailcow on same Docker network (trusted, no auth required).
# Set SMTP_HOST to enable — no SMTP_PASSWORD needed on trusted network.
#
# SMTP_HOST=172.22.1.253
# SMTP_PORT=587
# SMTP_USER=hello@aelira.ai
# SMTP_PASSWORD=
# FROM_EMAIL=hello@aelira.ai
# FROM_NAME=Aelira
# ADMIN_NOTIFICATION_EMAILS=founders@aelira.ai,reg@aelira.ai

# ===========================================
# JWT Authentication
# ===========================================
# Secret for signing JWT tokens (magic link auth)
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# JWT_SECRET=your-jwt-secret-here

# Where magic link emails redirect to (dashboard URL)
# MAGIC_LINK_BASE_URL=https://dashboard.aelira.ai

# ===========================================
# Error Tracking (Sentry)
# ===========================================
# Get DSN at: https://sentry.io
# SENTRY_DSN=https://xxxx@sentry.io/yyyy
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

# ===========================================
# Redis Authentication (Production)
# ===========================================
# REDIS_PASSWORD=your-redis-password-here

# ===========================================
# Database Credentials (Production)
# ===========================================
# POSTGRES_USER=aelira
# POSTGRES_PASSWORD=your-secure-password-here
# POSTGRES_DB=aelira

# ===========================================
# Umami Analytics (Self-Hosted)
# ===========================================
# Generate a random secret: openssl rand -base64 32
# UMAMI_APP_SECRET=your-umami-app-secret-here
# Umami Website ID (get from Umami dashboard after setup)
# UMAMI_WEBSITE_ID=your-website-uuid-here

# ===========================================
# Stripe Payment Processing (Tier Upgrades)
# ===========================================
# Get your API keys at: https://dashboard.stripe.com/apikeys
# Use test keys (pk_test_*, sk_test_*) for development
#
# IMPORTANT: Set statement descriptor in Stripe Dashboard:
# Settings > Business > Public details > Statement descriptor = "AELIRA"
# This is what customers see on their card statements
#
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# Webhook secret for verifying Stripe events
# Create webhook at: https://dashboard.stripe.com/webhooks
# Point to: https://api.aelira.ai/billing/webhook
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# Stripe Price IDs (create products/prices in Stripe Dashboard)
# Each product should have both USD and AUD prices attached
#
# USD Prices (default market)
# Individual Plus: $29/month, $278/year (20% off)
STRIPE_PRICE_INDIVIDUAL_PLUS_MONTHLY=price_your_plus_monthly_usd
STRIPE_PRICE_INDIVIDUAL_PLUS_YEARLY=price_your_plus_yearly_usd

# Individual Pro: $79/month, $758/year (20% off)
STRIPE_PRICE_INDIVIDUAL_PRO_MONTHLY=price_your_pro_monthly_usd
STRIPE_PRICE_INDIVIDUAL_PRO_YEARLY=price_your_pro_yearly_usd

# AUD Prices (Australian market - 1.5x multiplier for clean pricing)
# Individual Plus: $44 AUD/month, $422 AUD/year
STRIPE_PRICE_INDIVIDUAL_PLUS_MONTHLY_AUD=price_your_plus_monthly_aud
STRIPE_PRICE_INDIVIDUAL_PLUS_YEARLY_AUD=price_your_plus_yearly_aud

# Individual Pro: $119 AUD/month, $1142 AUD/year
STRIPE_PRICE_INDIVIDUAL_PRO_MONTHLY_AUD=price_your_pro_monthly_aud
STRIPE_PRICE_INDIVIDUAL_PRO_YEARLY_AUD=price_your_pro_yearly_aud

# Checkout redirect URLs (customize for your domain)
# STRIPE_SUCCESS_URL=https://dashboard.aelira.ai/settings?upgrade=success
# STRIPE_CANCEL_URL=https://dashboard.aelira.ai/settings?upgrade=cancelled

# ===========================================
# Twenty CRM (Self-Hosted)
# ===========================================
# Open source CRM for lead management
# Included in root docker-compose.yml (twenty-server service)
# Access at: http://localhost:3001
#
# TWENTY_ENABLED: Set to 'true' to enable CRM sync (default: false)
# When disabled, leads are only stored in PostgreSQL
TWENTY_ENABLED=false

# TWENTY_BASE_URL: URL to your Twenty instance
# Use http://twenty-server:3000 when running in Docker network
# Use http://localhost:3001 for local development
TWENTY_BASE_URL=http://localhost:3001

# TWENTY_API_KEY: Generate from Twenty dashboard
# Settings > API Keys > Create new key
# TWENTY_API_KEY=your-twenty-api-key-here

# TWENTY_WEBHOOK_SECRET: Secret for validating incoming webhooks
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# TWENTY_WEBHOOK_SECRET=your-webhook-secret-here

# TWENTY_APP_SECRET: Required by Twenty container for session encryption
# Generate: openssl rand -base64 32
# TWENTY_APP_SECRET=your-twenty-app-secret-here

# TWENTY_DISABLE_SIGNUP: Disable public signup (SECURITY: set to true in production)
# When true, only admins can create user accounts
TWENTY_DISABLE_SIGNUP=true

# TWENTY_BASIC_AUTH_USERS: Optional HTTP Basic Auth for CRM access (additional security layer)
# Generate: htpasswd -nb admin yourpassword | sed -e 's/\$/\$\$/g'
# Format: username:password_hash (double $$ for docker-compose)
# TWENTY_BASIC_AUTH_USERS=admin:$$apr1$$xyz...

# ===========================================
# AWS SES (Marketing Emails ONLY)
# ===========================================
# IMPORTANT: SES is for marketing/promotional emails ONLY.
# Transactional emails (magic links, alerts, etc.) use MXRoute/Mailcow via SMTP.
#
# Get credentials at: https://console.aws.amazon.com/iam/
# Create IAM user with AmazonSESFullAccess policy
#
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1

# Verified sender email for marketing (must be verified in SES)
SES_FROM_EMAIL=marketing@aelira.ai

# SES Configuration Set (for bounce/complaint/delivery tracking via SNS)
# Create in AWS Console: SES > Configuration sets > Create
# SES_CONFIGURATION_SET=aelira-marketing

# Base URL for tracking pixels and click redirects
# API_BASE_URL=https://api.aelira.ai

# ===========================================
# Docker Compose (Unified Production)
# ===========================================
# The root docker-compose.yml manages all backend services.
# Service hostnames are hardcoded to container names (aelira-db,
# aelira-backend-redis, aelira-backend-ollama, aelira-twenty-server).
# No hostname overrides needed — just set credentials above.

# ===========================================
# Production Security (uncomment for production)
# ===========================================
# SECRET_KEY=your-secret-key-here-min-32-chars
# API_KEY_HEADER=your-api-key-here
