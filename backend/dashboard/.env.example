# Dashboard Environment Variables Example
# Copy this file to .env and update with your actual values
# NEVER commit .env to git - it's in .gitignore

# API Backend URL
# Production: https://api.aelira.ai
# Development: http://localhost:8000
VITE_API_URL=http://localhost:8000

# NOTE: Authentication is ALWAYS validated against the backend.
# There is no dev mode bypass - you must use a valid API key.

# ===========================================
# Umami Analytics (Self-Hosted)
# ===========================================
# Only loads when user consents to analytics cookies
VITE_UMAMI_WEBSITE_ID=06c4936f-44a6-4bc7-afee-e204a4380116
VITE_UMAMI_URL=https://analytics.aelira.ai
