# Dashboard Environment Variables Example
# Copy this file to .env and update with your actual values
# NEVER commit .env to git - it's in .gitignore

# API Backend URL
# Development: http://localhost:8000
# Production: https://api.your-domain.com
VITE_API_URL=http://localhost:8000

# Keep this aligned with backend BRAND_NAME; email logos use EMAIL_LOGO_URL.
# VITE_BRAND_NAME=Example University Accessibility
# VITE_LOGO_LIGHT=/branding/logo-light.svg
# VITE_LOGO_DARK=/branding/logo-dark.svg

# Set your deployment's own privacy policy before onboarding users.
# No hosted Aelira policy is used when this is unset.
# VITE_PRIVACY_POLICY_URL=https://your-domain.com/privacy

# NOTE: Authentication is ALWAYS validated against the backend.
# There is no dev mode bypass - you must use a valid API key.

# ===========================================
# Analytics (Optional — supports Umami, a privacy-focused open-source analytics tool)
# ===========================================
# Off by default. Point these at YOUR OWN self-hosted Umami instance —
# nothing is ever sent to the Aelira project. Only loads when both values
# are set AND the user consents to analytics cookies.
# VITE_UMAMI_WEBSITE_ID=your-umami-website-id
# VITE_UMAMI_URL=https://analytics.your-domain.com
