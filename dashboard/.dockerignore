# Frontend builds COPY this context. Build arguments supply deployment values.
# Verify with: python scripts/verify_build_context.py (from the repository root)

# Local environments; retain only explicitly named public templates.
**/.env
**/.env.*
**/*.env
!**/.env.example
!**/.env.*.example

# Credential files and tool authentication state; keep application source.
**/secrets
**/.secrets
**/credentials
**/.credentials
**/credentials.json
**/service-account*.json
**/*.key
**/*.pem
**/*.crt
**/*.cert
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/.aws
**/.ssh
**/.docker
**/.kube
**/.netrc
**/.npmrc
**/.pypirc

# Local assistant state and release policy inputs.
**/.claude
**/.codex
**/.agents
**/.cursor
**/.gemini
**/.aider*
**/AGENTS.md
**/CLAUDE.md
**/.release-*

# Dependency environments, local build products and test output.
**/.venv
**/venv
**/env
**/ENV
**/.Python
**/__pycache__
**/*.py[cod]
**/*$py.class
**/*.egg-info
**/node_modules
**/dist
**/dist-ssr
**/build
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.cache
**/.coverage*
**/coverage.xml
**/coverage
**/coverage_html
**/htmlcov
**/test-results
**/playwright-report
**/*.log
**/*.sqlite
**/*.sqlite3
**/*.db
**/uploads
**/logs
**/tmp
**/temp

# Editor, version-control and operating-system state.
**/.vscode
**/.idea
**/*.swp
**/*.swo
**/*~
**/.git
**/.gitignore
**/.DS_Store
**/Thumbs.db
