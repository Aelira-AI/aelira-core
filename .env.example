# Aelira Core — environment configuration
# Copy to .env and edit. NEVER commit .env (it is gitignored).
#
# Only the REQUIRED FOR PRODUCTION COMPOSE section is mandatory for that
# deployment path. Everything else has working
# defaults (shown after each =). This file is reconciled against every
# os.getenv() in src/ — if a variable is not here, the code does not read it.

# ===========================================
# REQUIRED FOR PRODUCTION COMPOSE
# ===========================================
# The production Compose file builds DATABASE_URL from these values and uses
# the bundled `postgres` service. Replace every secret placeholder before use.
POSTGRES_USER=aelira
POSTGRES_PASSWORD=change-me-use-a-strong-random-password
POSTGRES_DB=aelira

# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# The app refuses to start without a real value.
JWT_SECRET=change-me-generate-a-real-secret

# Fernet key encrypting the short-lived cached token pair used for safe refresh replay.
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_REPLAY_ENCRYPTION_KEY=generate-a-fernet-key-for-this-deployment

# ===========================================
# Optional security and integration settings
# ===========================================
SESSION_REFRESH_GRACE_SECONDS=10

# Fernet key encrypting stored OAuth/BYOK tokens at rest.
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=your-token-encryption-key-here

# Separate Fernet key for workspace-scoped AI provider credentials.
# Generate and retain it exactly like TOKEN_ENCRYPTION_KEY.
# BYOK_ENCRYPTION_KEY=generate-a-fernet-key-for-provider-credentials

# ===========================================
# Deployment identity
# ===========================================
# Where this deployment is reachable; user-facing URLs derive from these.
PUBLIC_API_URL=http://localhost:8000
PUBLIC_DASHBOARD_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000
# CORS_EXPOSE_HEADERS=["Content-Disposition"]

# ===========================================
# Direct host development
# ===========================================
# These examples target services exposed on the host. Uncomment them only
# when running the API directly; leaving them inactive lets production Compose
# supply its `postgres`, `redis`, and `production` defaults.
# DATABASE_URL=postgresql://username:password@localhost:5432/aelira_dev
# REDIS_URL=redis://localhost:6379/0
# ENV=development

API_HOST=0.0.0.0
API_PORT=8000
# LOG_LEVEL=info
# DEBUG=false

# Branding shown in emails and accessibility evidence reports (see BRANDING.md)
# BRAND_NAME=Aelira
# PUBLIC_WEBSITE_URL=https://github.com/Aelira-AI/aelira-core
# SUPPORT_EMAIL=
# Where magic-link emails point (defaults to your dashboard URL)
# MAGIC_LINK_BASE_URL=
# DASHBOARD_URL=

# ===========================================
# Accounts & provisioning
# ===========================================
# Workspace tier for newly created departments: "department" (multi-user,
# the default) or "individual" (single-user). Both are free and unlimited;
# quotas are an admin governance tool, not a paywall — edit TIER_QUOTAS in
# src/config/settings.py only if you want caps.
DEFAULT_DEPARTMENT_TIER=department

# Provisioning is CLOSED by default: accounts come from admin invitations,
# LMS (LTI) launches, or domain-matched SSO. First login on an empty
# database bootstraps the admin regardless of this flag.
# OPEN_SIGNUP=false
# Cap on auto-created individual workspaces when OPEN_SIGNUP=true
# INDIVIDUAL_ACCOUNT_LIMIT=500

# Faculty compliance leaderboards are opt-in.
# GAMIFICATION_ENABLED=false

# Creating additional department records through POST /auth/departments requires
# an existing administrator by default. Set true only for a deliberately public
# provisioning endpoint, such as an isolated demo deployment.
ALLOW_PUBLIC_DEPARTMENT_CREATION=false

# REDIS_ENABLED=true

# ===========================================
# AI providers
# ===========================================
# Choose one primary: gemini, ollama, openai, anthropic, or xai.
# Open-core selects none by default and will not contact an AI vendor until you
# make this choice. Fallback is also opt-in.
LLM_PROVIDER=none
LLM_FALLBACK_PROVIDER=none
# Optional semantic WCAG search: none or ollama. Exact rule-ID grounding works
# without embeddings, so this is independent from LLM_PROVIDER.
EMBEDDING_PROVIDER=none

# --- Gemini — key: https://aistudio.google.com
# GEMINI_API_KEY=
# GEMINI_API_BASE=
# GEMINI_TEXT_MODEL=gemini-2.5-flash
# GEMINI_CODE_MODEL=gemini-2.5-flash
# GEMINI_VISION_MODEL=gemini-2.5-flash

# --- Ollama (fully local; see docs/deployment/local-ai-models.md)
# Docker Compose service URL. Use http://localhost:11434 only when running the
# API directly on the host instead of through the supplied Compose files.
OLLAMA_HOST=http://ollama:11434
# OLLAMA_API_KEY=
# OLLAMA_FALLBACK_TEXT=gemma3:4b
# OLLAMA_FALLBACK_CODE=qwen2.5-coder:7b
# OLLAMA_FALLBACK_VISION=qwen2.5vl:3b
# OLLAMA_TEXT_MODEL=gemma3:4b
# OLLAMA_CODE_MODEL=qwen2.5-coder:7b
# OLLAMA_VISION_MODEL=qwen2.5vl:3b
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest

# --- OpenAI, or ANY OpenAI-compatible endpoint (vLLM, LM Studio, TGI)
# OPENAI_API_KEY=
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_TEXT_MODEL=gpt-4o-mini
# OPENAI_CODE_MODEL=gpt-4o
# OPENAI_VISION_MODEL=gpt-4o

# --- Anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_API_BASE=https://api.anthropic.com/v1
# ANTHROPIC_TEXT_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_CODE_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_VISION_MODEL=claude-3-5-sonnet-20241022

# --- xAI
# XAI_API_KEY=
# XAI_API_BASE=https://api.x.ai/v1
# XAI_TEXT_MODEL=grok-2
# XAI_CODE_MODEL=grok-2
# XAI_VISION_MODEL=grok-2-vision

# --- Provider behaviour tuning
# LLM_REQUEST_TIMEOUT=120
# LLM_MAX_RETRIES=3
# LLM_THREAD_POOL_SIZE=4
# LLM_CACHE_ENABLED=true
# LLM_CACHE_TTL_HOURS=24
# HUGGINGFACE_TOKEN=
# Per-provider request limits; defaults shown.
# GEMINI_RATE_LIMIT_RPM=15
# GEMINI_RATE_LIMIT_RPD=1500
# OLLAMA_RATE_LIMIT_RPM=1000
# OLLAMA_RATE_LIMIT_RPD=100000
# OPENAI_RATE_LIMIT_RPM=60
# OPENAI_RATE_LIMIT_RPD=10000
# ANTHROPIC_RATE_LIMIT_RPM=60
# ANTHROPIC_RATE_LIMIT_RPD=10000
# XAI_RATE_LIMIT_RPM=60
# XAI_RATE_LIMIT_RPD=10000

# ===========================================
# Email (transactional only — magic links, alerts, invitations)
# ===========================================
# Any SMTP host works; SENDGRID_API_KEY switches to the SendGrid API.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# FROM_EMAIL=noreply@your-domain.com
# FROM_NAME=Aelira
# ADMIN_NOTIFICATION_EMAILS=admin@your-domain.com
# SENDGRID_API_KEY=

# ===========================================
# LMS integrations (LTI 1.3 + OAuth) — all optional
# ===========================================
# Each LMS needs its own registration; see docs/ for per-LMS guides.
# BLACKBOARD_CLIENT_ID=
# BLACKBOARD_DEPLOYMENT_ID=
# BLACKBOARD_LTI_CONFIG_FILE=blackboard_lti_config.json
# Required together for Blackboard LTI signing; use a matching RSA 2048+ pair.
# BLACKBOARD_LTI_PRIVATE_KEY_PATH=/run/secrets/blackboard-lti-private.pem
# BLACKBOARD_LTI_PUBLIC_KEY_PATH=/run/secrets/blackboard-lti-public.pem
# Optional comma-separated future/retiring public PEM paths used during rotation.
# BLACKBOARD_LTI_OVERLAP_PUBLIC_KEY_PATHS=/run/secrets/blackboard-lti-overlap-public.pem
# BLACKBOARD_OAUTH_CLIENT_ID=
# BLACKBOARD_OAUTH_CLIENT_SECRET=
# Required when Blackboard OAuth is executable in staging/production:
# comma-separated canonical HTTPS root origins, with exact matches only.
# BLACKBOARD_OAUTH_ALLOWED_ORIGINS=https://blackboard.university.edu
# BLACKBOARD_URL=
# BRIGHTSPACE_CLIENT_ID=
# BRIGHTSPACE_CLIENT_SECRET=
# Exact Brightspace OAuth origins allowed to return credentials.
# BRIGHTSPACE_OAUTH_ALLOWED_ORIGINS=https://brightspace.example.edu
# BRIGHTSPACE_LTI_AUTH_URL={base}{self.BRIGHTSPACE_AUTH_PATH}
# BRIGHTSPACE_LTI_CLIENT_ID=
# BRIGHTSPACE_LTI_DEPLOYMENT_ID=
# BRIGHTSPACE_LTI_ISSUER=
# BRIGHTSPACE_LTI_KEYSET_URL={base}{self.BRIGHTSPACE_JWKS_PATH}
# BRIGHTSPACE_LTI_PRIVATE_KEY_PATH=
# BRIGHTSPACE_LTI_PUBLIC_KEY_PATH=
# BRIGHTSPACE_LTI_TOKEN_URL={base}{self.BRIGHTSPACE_TOKEN_PATH}
# CANVAS_CLIENT_ID=
# CANVAS_DEPLOYMENT_ID=
# CANVAS_ISSUER=https://canvas.instructure.com
# CANVAS_LTI_PRIVATE_KEY_PATH=
# CANVAS_LTI_PUBLIC_KEY_PATH=
# CANVAS_OAUTH_REDIRECT_URI=http://localhost:8000/canvas/oauth/callback
# CANVAS_OAUTH_CLIENT_ID=
# CANVAS_OAUTH_CLIENT_SECRET=
# Development-only origin for a Canvas service reachable on the Docker network.
# CANVAS_DOCKER_ORIGIN=http://canvas:3000
# Required in staging/production: comma-separated canonical HTTPS root origins.
# No wildcards or suffixes (example: https://canvas.university.edu).
# CANVAS_OAUTH_ALLOWED_ORIGINS=https://canvas.university.edu
# LTI_ACCESS_TOKEN_EXPIRE_MINUTES=120
# LTI_CONFIG_FILE=lti_config.json
# MOODLE_CLIENT_ID=
# MOODLE_CLIENT_SECRET=

# ===========================================
# Cloud storage sign-in (Google Workspace / Microsoft 365) — optional
# ===========================================
# GOOGLE_*: Drive/Docs integration. GOOGLE_OAUTH_*: user SSO login.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/google/callback
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:8000/microsoft/callback
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_TENANT_ID=common

# ===========================================
# Auth & security tuning (defaults are production-sane)
# ===========================================
# JWT_ALGORITHM supports HS256 (JWT_SECRET) or RS256 (key paths below).
# ALLOW_MOCK_AUTH is dev-only and hard-blocked in production/staging.
# ALLOW_MOCK_AUTH=false
# Comma-separated IPv4/IPv6 CIDRs for reverse proxies allowed to supply client
# addresses. Empty means forwarding headers are ignored. Use network addresses
# for CIDRs, or /32 (IPv4) and /128 (IPv6) for exact proxy hosts. Example:
# TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
# JWT_ALGORITHM=HS256
# JWT_PRIVATE_KEY_PATH=
# JWT_PUBLIC_KEY_PATH=
# JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Maximum legacy refresh-token candidates examined during bounded migration fallback.
# SESSION_LEGACY_REFRESH_CANDIDATE_LIMIT=5
# MAGIC_LINK_EXPIRE_MINUTES=15
# Leave SESSION_COOKIE_DOMAIN empty unless the authenticated session itself
# must be sent to sibling hosts. A sibling dashboard calling the API does not
# require this; the API can keep its session cookie host-only.
# SESSION_COOKIE_DOMAIN=
# SESSION_COOKIE_NAME=aelira_session
# SESSION_COOKIE_SAMESITE=Lax
# SESSION_COOKIE_SECURE=true
# Set CSRF_COOKIE_DOMAIN to a shared parent only when browser JavaScript on a
# sibling dashboard host must read the double-submit token, e.g. .example.org.
# Values are bare DNS domains: no scheme, port, path, wildcard, or trailing dot.
# CSRF_COOKIE_DOMAIN=
# CSRF_COOKIE_SAMESITE=Lax
# CSRF_COOKIE_SECURE=true
# DELETED_ACCOUNT_EMAIL_DOMAIN=deleted.invalid
# ENABLE_CSRF=true
# ENABLE_HSTS=true
# ENABLE_SECURITY_HEADERS=true
# HSTS_MAX_AGE=31536000

# ===========================================
# Processing limits & tuning (defaults shown; raise/lower to taste)
# ===========================================
# Where uploads and remediated files are written (defaults to /app/* in
# container). AELIRA_UPLOAD_DIR falls back to UPLOAD_DIR if the former is unset.
# UPLOAD_DIR=/app/uploads
# AELIRA_UPLOAD_DIR=/app/uploads
# AELIRA_REMEDIATION_DIR=/app/remediated
# Managed remediation and report artifacts must use durable shared storage visible at the
# same path to all API and worker replicas. A container-local filesystem is not
# safe when replicas can resolve, write, or clean artifacts independently.
REMEDIATION_ARTIFACT_DIR=/app/uploads/remediation-artifacts
REPORT_ARTIFACT_DIR=/app/uploads/report-artifacts
REPORT_ARTIFACT_MAX_BYTES=20971520
REMEDIATION_ARTIFACT_RETENTION_DAYS=30
REMEDIATION_ARTIFACT_APPROVED_RETENTION_DAYS=30
REMEDIATION_ARTIFACT_WRITTEN_RETENTION_DAYS=7
REMEDIATION_ARTIFACT_MAX_BYTES=524288000
REMEDIATION_ARTIFACT_CLEANUP_BATCH_SIZE=100
REMEDIATION_ARTIFACT_STAGING_GRACE_SECONDS=3600
# REMEDIATION_ARTIFACT_ORPHAN_BATCH_SIZE=100
# REMEDIATION_ARTIFACT_ORPHAN_GRACE_SECONDS=86400
# REMEDIATION_ARTIFACT_ORPHAN_MAX_VISITED_ENTRIES=2000
# REMEDIATION_ARTIFACT_ORPHAN_MAX_VISITED_DIRECTORIES=500
# REMEDIATION_ARTIFACT_ORPHAN_MAX_DIRECTORY_ENTRIES=1000
# REMEDIATION_ARTIFACT_ORPHAN_MAX_SECONDS=5
# REMEDIATION_ARTIFACT_QUARANTINE_RETENTION_DAYS=30
# DURABLE_MAINTENANCE_INTERVAL_SECONDS=300
# Ollama model overrides for the classifier/coder lanes (see local-ai-models.md)
# AELIRA_CLASSIFIER_MODEL=
# AELIRA_CODER_MODEL=
# AELIRA_MODEL_PROFILE=recommended
# MULTIMEDIA_MAX_DURATION=3600
# MULTIMEDIA_MAX_FRAMES=200
# PDF_MAX_PAGES=500
# PDF_MAX_SIZE_MB=100
# PDF_OCR_BATCH_SIZE=10
# PDF_OCR_DPI=150
# PDF_PROCESSING_TIMEOUT=300
# Hard wall deadline for one queued remediation child (30 minutes by default).
# REMEDIATION_EXECUTION_TIMEOUT_SECONDS=1800
# Grace period between process-group termination and forced kill.
# REMEDIATION_TERMINATION_GRACE_SECONDS=10
# Jobs executed by one standalone worker at a time.
# JOB_WORKER_MAX_CONCURRENCY=4
# Terminal health threshold for a single executing job.
# JOB_WORKER_MAX_EXECUTION_SECONDS=3600
# SCAN_TIMEOUT_CHECK_INTERVAL=300
# SCAN_TIMEOUT_MINUTES=30
# SQL_ECHO=false
# VERAPDF_ENABLED=false
# VERAPDF_URL=http://localhost:8080
# WEB_PAGE_LOAD_TIMEOUT=30
# WEB_SCAN_TIMEOUT=120
# XLSX_MAX_COLS=100
# XLSX_MAX_ROWS=10000

# ===========================================
# Error tracking (optional; only initializes when SENTRY_DSN is set)
# ===========================================
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_PROFILES_SAMPLE_RATE=0.1

# ===========================================
# Legacy aliases (older code paths; prefer the primary names above)
# ===========================================
# API_BASE_URL=   # older alias some LTI routes check before PUBLIC_API_URL
# BASE_URL=       # same
# ENVIRONMENT=    # older alias of ENV read by one middleware check
# USE_GEMINI=false  # older direct-client flag; prefer LLM_PROVIDER=gemini
