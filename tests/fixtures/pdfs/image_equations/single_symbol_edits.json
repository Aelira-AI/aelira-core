      "edits": [
        {"kind": "change_digit", "reading": "x^{3} + 3x - 7 = 0"},
        {"kind": "change_digit", "reading": "x^{2} + 3x - 9 = 0"},
        {"kind": "change_digit", "reading": "x^{2} + 5x - 7 = 0"},
        {"kind": "swap_sign", "reading": "x^{2} - 3x - 7 = 0"},
        {"kind": "swap_sign", "reading": "x^{2} + 3x + 7 = 0"},
        {"kind": "change_variable", "reading": "y^{2} + 3x - 7 = 0"},
        {"kind": "drop_term", "reading": "x^{2} + 3x = 0"}
      ]
    },
    {
