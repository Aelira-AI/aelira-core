# Preserve the PDF fixture's byte offsets and fixed-width cross-reference records.
tests/fixtures/document_stack/metadata.pdf binary

# Keep the frozen Windows comparison inputs and source hashes byte-identical.
runtime-security/gnutls-upn-observation/** -text
.github/workflows/gnutls-upn-observation.yml text eol=lf

# Keep the pinned Debian source inputs and reviewed patches byte-identical,
# including their original context indentation. Build-time SHA-256
# verification depends on these bytes.
docker/debian-backports/*/patches/*.patch -text -whitespace
docker/debian-backports/*/*.dsc -text -whitespace
docker/debian-backports/*/*.asc -text -whitespace
